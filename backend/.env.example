# Sin DATABASE_URL se usa PGlite (Postgres embebido) en ./.pglite para desarrollo local.
# En Render, usa la "Internal Database URL" de tu Postgres.
DATABASE_URL=
JWT_SECRET=cambia-esto-por-un-secreto-largo
CORS_ORIGINS=http://localhost:5173
ADMIN_EMAIL=admin@arbol.co
ADMIN_PASSWORD=arbol123
PORT=4000

# Correos de reservas (opcional; sin SMTP_HOST no se envía nada). Con Gmail usa una contraseña de aplicación.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Árbol Private Studio <arbolprivategym@gmail.com>"
# Correos del estudio que reciben aviso de reservas y cancelaciones (separados por coma).
NOTIFY_EMAIL=
# URL pública de la app, para el enlace en los correos.
APP_URL=
